{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-smallresources/data/teleports.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "from": {
          "description": "First end",
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "heading"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          }
        },
        "to": {
          "description": "Second end",
          "type": "object",
          "required": [
            "x",
            "y",
            "z",
            "heading"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "heading": {
              "type": "number"
            }
          }
        },
        "jobs": {
          "description": "Jobs: Only members of these jobs can use it. Leave jobs and gangs empty for everyone.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "gangs": {
          "description": "Gangs: Members of these gangs can use it too.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "onDuty": {
          "description": "Only on duty: Job members must be on duty in that job.",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "from",
        "to"
      ]
    }
  },
  "additionalProperties": false
}
