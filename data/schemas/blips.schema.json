{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-smallresources/data/blips.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "This file's JSON Schema (for editors)."
    }
  },
  "patternProperties": {
    "^[a-z0-9_]{2,32}$": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name",
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "point": {
          "description": "Place",
          "type": "object",
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            }
          }
        },
        "blip": {
          "description": "Icon",
          "type": "object",
          "properties": {
            "sprite": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "color": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "scale": {
              "type": "number",
              "minimum": 0.3,
              "maximum": 2
            }
          },
          "required": [
            "sprite",
            "color",
            "scale"
          ]
        },
        "shortRange": {
          "description": "Only when close: On the minimap only near the place; off keeps it at the minimap's edge from anywhere.",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "point",
        "blip",
        "shortRange"
      ]
    }
  },
  "additionalProperties": false
}
